  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@secretlint/secretlint-rule-preset-recommend": "^11.3.1",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.0.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.3",
    "husky": "^9.1.7",
    "postcss": "^8.5.6",
    "secretlint": "^11.3.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5"
  }

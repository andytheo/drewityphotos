{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "scan:secrets": "secretlint \"**/*\" \"!node_modules/**\" \"!.next/**\"",
